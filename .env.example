APP_NAME="Portal Praktikum"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8095
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_PORT=8095
# Loopback only by default. Use 0.0.0.0 only when no tunnel/reverse proxy is in front and the firewall is reviewed.
APP_BIND=127.0.0.1
# Fixed Docker network for Nginx; change both if the subnet is already used on the VM.
WEB_SUBNET=10.231.0.0/24
WEB_GATEWAY=10.231.0.1
# cloudflared on the host connects through the Docker gateway above. Comma-separated IP/CIDR.
# Behind Nginx Proxy Manager: NPM's exact container IP (see docs/15_VPS_NPM.md), never its whole subnet.
TRUSTED_PROXIES=10.231.0.1
# Nginx Proxy Manager on the same VPS: uncomment both (docs/15_VPS_NPM.md).
#COMPOSE_FILE=compose.yaml:compose.npm.yaml
#NPM_NETWORK=npm_default
DB_CONNECTION=mysql
DB_HOST=mysql-lab
DB_PORT=3306
DB_DATABASE=Lab
DB_USERNAME=portal_lab
DB_PASSWORD=
MYSQL_EXTERNAL_NETWORK=lab-external
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stack
LOG_LEVEL=warning
# Backup (M6). Host folder must exist and be owned by UID 33: sudo install -d -o 33 -g 33 -m 0750 /DATA/AppData/portal-backups
BACKUP_ENABLED=false
BACKUP_HOST_PATH=/DATA/AppData/portal-backups
BACKUP_DESTINATION=/backups
BACKUP_DESTINATION_LABEL="Disk backup lokal VM"
# Required when archives leave the VM; set on the server only.
BACKUP_PASSWORD=
# Proposal only; admin can change time/retention in Pengaturan > Backup.
BACKUP_TIME=02:00
BACKUP_RETENTION=7
# Extra backup after this many logged changes since the last good one (0 = off), at most once per interval (minutes).
# Off-site copies with Rclone on the host: docs/16_BACKUP_RCLONE.md
BACKUP_CHANGE_THRESHOLD=0
BACKUP_CHANGE_MIN_INTERVAL=60
# Isolated database for portal:backup-verify --restore (never Lab).
RESTORE_DB_DATABASE=portal_restore
RESTORE_DB_USERNAME=
RESTORE_DB_PASSWORD=

# Dapat diturunkan; batas runtime maksimum 10 MB per berkas M3.
ACADEMIC_UPLOAD_MAX_KB=10240

# Public portal limits per minute. Labs share one public IP, so per-IP values are generous.
PORTAL_SUBMIT_PER_IP=300
PORTAL_SUBMIT_PER_IDENTITY=6
PORTAL_STATUS_PER_IP=120
PORTAL_DOWNLOAD_PER_IP=300
# PHP-FPM workers (image default 16). Roughly 60 MB each at peak; lower on small VPS.
#FPM_MAX_CHILDREN=16
